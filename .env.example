# =================================================================
# ASISTEN BOT ENVIRONMENT CONFIGURATION
# =================================================================

# --- TELEGRAM BOT CONFIGURATION ---
# Dapatkan token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# User ID Telegram yang diizinkan menggunakan bot (pisahkan dengan koma)
# Dapatkan User ID Anda via @userinfobot di Telegram
TELEGRAM_ALLOWED_USERS=123456789

# --- 9ROUTER AI CONFIGURATION ---
# API Key untuk 9Router (OpenAI-compatible endpoint)
NINEROUTER_API_KEY=your_9router_api_key_here

# Base URL untuk 9Router (contoh: https://api.9router.com/v1 atau URL server remote 9Router Anda)
NINEROUTER_BASE_URL=https://api.9router.com/v1

# Model AI yang digunakan via 9Router
NINEROUTER_MODEL=gpt-4o-mini

# --- GOOGLE SHEETS CONFIGURATION ---
# ID Google Sheet (diambil dari URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Path ke file Service Account Credentials JSON Google Cloud
GOOGLE_CREDENTIALS_FILE=credentials.json

# --- DATABASE & SYSTEM CONFIGURATION ---
# Path tempat penyimpanan cache SQLite
DATABASE_PATH=data/app.db

# Level logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
